# ============================================
# ADMIN FINANCEIRO - Configuração (EXEMPLO)
# ============================================

# Servidor
PORT=3001
NODE_ENV=development

# Banco ERP (somente leitura)
ERP_DB_HOST=192.168.0.x
ERP_DB_PORT=3306
ERP_DB_NAME=SAS
ERP_DB_USER=sync
ERP_DB_PASS=sua_senha_aqui

# Banco Admin (leitura e escrita)
ADMIN_DB_HOST=192.168.0.x
ADMIN_DB_PORT=3306
ADMIN_DB_NAME=admin_financeiro
ADMIN_DB_USER=admin_app
ADMIN_DB_PASS=sua_senha_aqui

# JWT
JWT_SECRET=gere-uma-chave-segura
JWT_EXPIRES_IN=8h

# Upload de comprovantes
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Banco do Brasil - API Extratos
BB_AMBIENTE=prod
BB_APP_KEY=
BB_CLIENT_ID=
BB_CLIENT_SECRET=
BB_AGENCIA=
BB_CONTA=
# mTLS exigido pela API de extratos (e-CNPJ A1 ou cert de CA aceita)
BB_CERT_PFX=
BB_CERT_SENHA=
# alternativa em PEM:
BB_CERT_CRT=
BB_CERT_KEY=
